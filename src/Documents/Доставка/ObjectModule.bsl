#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если (Статус = Перечисления.СтатусыДоставок.ОтклоненаКурьером
			Или Статус = Перечисления.СтатусыДоставок.ОтклоненаКлиентом)
		И ПустаяСтрока(Комментарий) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Для статуса ""Отклонена курьером"" или ""Отклонена клиентом"" необходимо заполнить комментарий";
		Сообщение.Сообщить();
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
