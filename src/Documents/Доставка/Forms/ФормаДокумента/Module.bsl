#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.Фото) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеФото = Объект.Фото.Получить();
	Если ТипЗнч(ДанныеФото) = Тип("ДвоичныеДанные") Тогда
		ФотоКартинка = Новый Картинка(ДанныеФото);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СделатьФото(Команда)
	
	#Если МобильноеПриложениеКлиент Тогда
		
		Если Не СредстваМультимедиа.ПоддерживаетсяФотоснимок() Тогда
			ПоказатьОповещениеПользователя("Съёмка фото не поддерживается устройством");
			Возврат;
		КонецЕсли;
		
		Снимок = СредстваМультимедиа.СделатьФотоснимок();
		Если Снимок = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ДанныеФото = Снимок.ПолучитьДвоичныеДанные();
		Объект.Фото = Новый ХранилищеЗначения(ДанныеФото);
		ФотоКартинка = Новый Картинка(ДанныеФото);
		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура Позвонить(Команда)
	
	Телефон = ПолучитьТелефонКонтрагента();
	Если ПустаяСтрока(Телефон) Тогда
		ПоказатьОповещениеПользователя("У контрагента не заполнен номер телефона");
		Возврат;
	КонецЕсли;
	
	#Если МобильноеПриложениеКлиент Тогда
		СредстваТелефонии.НабратьНомер(Телефон, Истина);
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьТелефонКонтрагента()
	
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Контрагенты.Телефон КАК Телефон
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Объект.Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Телефон;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти
