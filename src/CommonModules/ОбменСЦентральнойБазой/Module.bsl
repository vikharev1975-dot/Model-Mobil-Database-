#Область ПрограммныйИнтерфейс

// Возвращает узел плана обмена текущего мобильного устройства.
// При первом обращении узел создаётся.
//
// Возвращаемое значение:
//  ПланОбменаСсылка.ОбменСМобильнымПриложением - узел обмена.
Функция УзелОбмена() Экспорт
	
	Идентификатор = ИдентификаторТекущегоУстройства();
	
	Узел = ПланыОбмена.ОбменСМобильнымПриложением.НайтиПоКоду(Идентификатор);
	Если Не Узел.Пустая() Тогда
		Возврат Узел;
	КонецЕсли;
	
	ОбъектУзла = ПланыОбмена.ОбменСМобильнымПриложением.СоздатьУзел();
	ОбъектУзла.Код = Идентификатор;
	ОбъектУзла.Наименование = "Мобильное устройство " + Идентификатор;
	ОбъектУзла.Записать();
	
	Возврат ОбъектУзла.Ссылка;
	
КонецФункции

// Регистрирует изменение документа "Доставка" для передачи в центральную базу.
//
// Параметры:
//  Ссылка - ДокументСсылка.Доставка - изменённый документ.
Процедура ЗарегистрироватьИзменение(Ссылка) Экспорт
	
	Если Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена(), Ссылка);
	
КонецПроцедуры

// Выполняет синхронизацию данных с центральной базой:
// передаёт изменения статусов и комментариев, получает доставки,
// выгружает фотографии и снимает регистрацию изменений.
//
// Возвращаемое значение:
//  Строка - отчёт о выполнении синхронизации.
Функция ВыполнитьСинхронизацию() Экспорт
	
	Узел = УзелОбмена();
	
	ДокументыКОтправке = ПодготовитьИзменения(Узел);
	
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("deviceId", ИдентификаторТекущегоУстройства());
	ТелоЗапроса.Вставить("documents", ДокументыКОтправке);
	
	Ответ = ВызватьСервис("/exchange", ЗаписатьЗначениеJSON(ТелоЗапроса));
	ДанныеОтвета = ПрочитатьЗначениеJSON(Ответ);
	
	ПолученоДокументов = ПрименитьДанныеЦентральнойБазы(ДанныеОтвета);
	
	ОтправленоФото = ВыгрузитьФото(Узел);
	
	ПланыОбмена.УдалитьРегистрациюИзменений(Узел);
	
	Отчёт = "Синхронизация выполнена." + Символы.ПС
		+ "Отправлено изменений: " + ДокументыКОтправке.Количество() + "." + Символы.ПС
		+ "Получено документов: " + ПолученоДокументов + "." + Символы.ПС
		+ "Отправлено фотографий: " + ОтправленоФото + ".";
	
	Возврат Отчёт;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает идентификатор устройства, генерируя его при первом обращении.
//
// Возвращаемое значение:
//  Строка - идентификатор устройства.
Функция ИдентификаторТекущегоУстройства()
	
	Идентификатор = СокрЛП(Константы.ИдентификаторУстройства.Получить());
	Если ПустаяСтрока(Идентификатор) Тогда
		Идентификатор = Строка(Новый УникальныйИдентификатор());
		Константы.ИдентификаторУстройства.Установить(Идентификатор);
	КонецЕсли;
	
	Возврат Идентификатор;
	
КонецФункции

// Формирует массив изменённых документов для передачи в центральную базу.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменСМобильнымПриложением - узел обмена.
//
// Возвращаемое значение:
//  Массив из Структура - данные документов:
//   * uuid - Строка - уникальный идентификатор документа;
//   * status - Строка - имя статуса;
//   * comment - Строка - комментарий курьера.
Функция ПодготовитьИзменения(Узел)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Доставки.Ссылка КАК Ссылка,
		|	Доставки.Статус КАК Статус,
		|	Доставки.Комментарий КАК Комментарий
		|ИЗ
		|	Документ.Доставка КАК Доставки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Не ПланыОбмена.ИзменениеЗарегистрировано(Узел, Выборка.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		Данные = Новый Структура;
		Данные.Вставить("uuid", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Данные.Вставить("status", СтатусВСтроку(Выборка.Статус));
		Данные.Вставить("comment", Строка(Выборка.Комментарий));
		Результат.Добавить(Данные);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Создаёт и обновляет документы "Доставка" по данным центральной базы.
//
// Параметры:
//  ДанныеОтвета - Структура - разобранный JSON ответа сервиса.
//
// Возвращаемое значение:
//  Число - количество обработанных документов.
Функция ПрименитьДанныеЦентральнойБазы(ДанныеОтвета)
	
	ДокументыИзОтвета = ЗначениеСвойства(ДанныеОтвета, "documents");
	Если ТипЗнч(ДокументыИзОтвета) <> Тип("Массив") Тогда
		Возврат 0;
	КонецЕсли;
	
	СсылкиДокументов = Новый Массив;
	СсылкиКонтрагентов = Новый Массив;
	СсылкиНоменклатуры = Новый Массив;
	
	Для Каждого ДанныеДокумента Из ДокументыИзОтвета Цикл
		
		Если ТипЗнч(ДанныеДокумента) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьСсылкуПоИдентификатору(СсылкиДокументов, Документы.Доставка,
			СтроковоеЗначение(ДанныеДокумента, "uuid"));
		
		ДанныеКонтрагента = ЗначениеСвойства(ДанныеДокумента, "counterparty");
		ДобавитьСсылкуПоИдентификатору(СсылкиКонтрагентов, Справочники.Контрагенты,
			СтроковоеЗначение(ДанныеКонтрагента, "uuid"));
		
		Товары = ЗначениеСвойства(ДанныеДокумента, "goods");
		Если ТипЗнч(Товары) = Тип("Массив") Тогда
			Для Каждого ДанныеТовара Из Товары Цикл
				ДобавитьСсылкуПоИдентификатору(СсылкиНоменклатуры, Справочники.Номенклатура,
					СтроковоеЗначение(ДанныеТовара, "nomenclatureUuid"));
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	СуществующиеДокументы = СуществующиеСсылки("Документ.Доставка", СсылкиДокументов);
	СуществующиеКонтрагенты = СуществующиеСсылки("Справочник.Контрагенты", СсылкиКонтрагентов);
	СуществующаяНоменклатура = СуществующиеСсылки("Справочник.Номенклатура", СсылкиНоменклатуры);
	
	Количество = 0;
	Для Каждого ДанныеДокумента Из ДокументыИзОтвета Цикл
		
		Если ТипЗнч(ДанныеДокумента) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗаписатьДокумент(ДанныеДокумента, СуществующиеДокументы,
				СуществующиеКонтрагенты, СуществующаяНоменклатура) Тогда
			Количество = Количество + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

// Записывает документ "Доставка" по данным центральной базы.
//
// Параметры:
//  ДанныеДокумента - Структура - данные документа из ответа сервиса.
//  СуществующиеДокументы - Соответствие - существующие документы.
//  СуществующиеКонтрагенты - Соответствие - существующие контрагенты.
//  СуществующаяНоменклатура - Соответствие - существующая номенклатура.
//
// Возвращаемое значение:
//  Булево - Истина, если документ записан.
Функция ЗаписатьДокумент(ДанныеДокумента, СуществующиеДокументы,
		СуществующиеКонтрагенты, СуществующаяНоменклатура)
	
	Идентификатор = СтроковоеЗначение(ДанныеДокумента, "uuid");
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Ссылка = Документы.Доставка.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
	
	Если СуществующиеДокументы.Получить(Ссылка) = Истина Тогда
		Объект = Ссылка.Получить();
	Иначе
		Объект = Документы.Доставка.СоздатьДокумент();
		Объект.УстановитьСсылкуНового(Ссылка);
	КонецЕсли;
	
	Объект.ОбменДанными.Загрузка = Истина;
	
	Номер = СтроковоеЗначение(ДанныеДокумента, "number");
	Если Не ПустаяСтрока(Номер) Тогда
		Объект.Номер = Номер;
	КонецЕсли;
	
	Объект.Дата = ДатаИзСтроки(СтроковоеЗначение(ДанныеДокумента, "date"));
	Объект.АдресДоставки = СтроковоеЗначение(ДанныеДокумента, "address");
	Объект.Комментарий = СтроковоеЗначение(ДанныеДокумента, "comment");
	Объект.Статус = СтатусПоСтроке(СтроковоеЗначение(ДанныеДокумента, "status"));
	Объект.Контрагент = НайтиИлиСоздатьКонтрагента(
		ЗначениеСвойства(ДанныеДокумента, "counterparty"), СуществующиеКонтрагенты);
	
	Объект.Товары.Очистить();
	Товары = ЗначениеСвойства(ДанныеДокумента, "goods");
	Если ТипЗнч(Товары) = Тип("Массив") Тогда
		Для Каждого ДанныеТовара Из Товары Цикл
			НоваяСтрока = Объект.Товары.Добавить();
			НоваяСтрока.Номенклатура = НайтиИлиСоздатьНоменклатуру(ДанныеТовара, СуществующаяНоменклатура);
			НоваяСтрока.Количество = ЧисловоеЗначение(ДанныеТовара, "quantity");
		КонецЦикла;
	КонецЕсли;
	
	Объект.Записать();
	
	Возврат Истина;
	
КонецФункции

// Находит контрагента по уникальному идентификатору или создаёт его.
//
// Параметры:
//  ДанныеКонтрагента - Структура - данные контрагента из ответа сервиса.
//  СуществующиеКонтрагенты - Соответствие - существующие контрагенты.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты - контрагент.
Функция НайтиИлиСоздатьКонтрагента(ДанныеКонтрагента, СуществующиеКонтрагенты)
	
	Идентификатор = СтроковоеЗначение(ДанныеКонтрагента, "uuid");
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Ссылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
	Если СуществующиеКонтрагенты.Получить(Ссылка) = Истина Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Объект.УстановитьСсылкуНового(Ссылка);
	Объект.Наименование = СтроковоеЗначение(ДанныеКонтрагента, "name");
	Объект.Телефон = СтроковоеЗначение(ДанныеКонтрагента, "phone");
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
	Возврат Объект.Ссылка;
	
КонецФункции

// Находит номенклатуру по уникальному идентификатору или создаёт её.
//
// Параметры:
//  ДанныеТовара - Структура - данные строки товаров из ответа сервиса.
//  СуществующаяНоменклатура - Соответствие - существующая номенклатура.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - номенклатура.
Функция НайтиИлиСоздатьНоменклатуру(ДанныеТовара, СуществующаяНоменклатура)
	
	Идентификатор = СтроковоеЗначение(ДанныеТовара, "nomenclatureUuid");
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Ссылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
	Если СуществующаяНоменклатура.Получить(Ссылка) = Истина Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Объект = Справочники.Номенклатура.СоздатьЭлемент();
	Объект.УстановитьСсылкуНового(Ссылка);
	Объект.Наименование = СтроковоеЗначение(ДанныеТовара, "nomenclature");
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
	Возврат Объект.Ссылка;
	
КонецФункции

// Выгружает фотографии зарегистрированных на узле документов в центральную базу.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменСМобильнымПриложением - узел обмена.
//
// Возвращаемое значение:
//  Число - количество отправленных фотографий.
Функция ВыгрузитьФото(Узел)
	
	Отправлено = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Доставки.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Доставка КАК Доставки
		|ГДЕ
		|	Доставки.Фото <> НЕОПРЕДЕЛЕНО";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Не ПланыОбмена.ИзменениеЗарегистрировано(Узел, Выборка.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		Объект = Выборка.Ссылка.Получить();
		Если Объект = Неопределено Или Не ЗначениеЗаполнено(Объект.Фото) Тогда
			Продолжить;
		КонецЕсли;
		
		ДвоичныеДанные = Объект.Фото.Получить();
		СтрокаBase64 = СтрЗаменить(СтрЗаменить(Base64Строка(ДвоичныеДанные), Символы.ВК, ""), Символы.ПС, "");
		
		ТелоЗапроса = Новый Структура;
		ТелоЗапроса.Вставить("deviceId", ИдентификаторТекущегоУстройства());
		ТелоЗапроса.Вставить("documentUuid", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		ТелоЗапроса.Вставить("photoBase64", СтрокаBase64);
		
		ВызватьСервис("/uploadPhoto", ЗаписатьЗначениеJSON(ТелоЗапроса));
		Отправлено = Отправлено + 1;
		
	КонецЦикла;
	
	Возврат Отправлено;
	
КонецФункции

// Выполняет POST-запрос к HTTP-сервису центральной базы.
//
// Параметры:
//  Ресурс - Строка - адрес ресурса сервиса, например "/exchange".
//  ТелоЗапроса - Строка - тело запроса в формате JSON.
//
// Возвращаемое значение:
//  Строка - тело ответа в формате JSON.
Функция ВызватьСервис(Ресурс, ТелоЗапроса)
	
	Параметры = ПараметрыПодключения();
	
	Соединение = Новый HTTPСоединение(
		Параметры.Хост,
		Параметры.Порт,
		СокрЛП(Константы.Логин.Получить()),
		Константы.Пароль.Получить(),
		,
		30);
	
	Запрос = Новый HTTPЗапрос(Параметры.База + "/hs/courier" + Ресурс);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8");
	
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Сервер обмена вернул код " + Ответ.КодСостояния + ": "
			+ Ответ.ПолучитьТелоКакСтроку("UTF-8");
	КонецЕсли;
	
	Возврат Ответ.ПолучитьТелоКакСтроку("UTF-8");
	
КонецФункции

// Разбирает адрес сервера из константы на хост, порт и путь публикации базы.
//
// Возвращаемое значение:
//  Структура - параметры подключения:
//   * Хост - Строка - имя или IP-адрес сервера;
//   * Порт - Число - номер порта;
//   * База - Строка - путь публикации базы, например "/TradeEnterprise".
Функция ПараметрыПодключения()
	
	Адрес = СокрЛП(Константы.АдресСервера.Получить());
	Если ПустаяСтрока(Адрес) Тогда
		ВызватьИсключение "Не заполнена константа ""Адрес сервера"".";
	КонецЕсли;
	
	Если ВРег(Лев(Адрес, 7)) = "HTTP://" Тогда
		Адрес = Сред(Адрес, 8);
	ИначеЕсли ВРег(Лев(Адрес, 8)) = "HTTPS://" Тогда
		ВызватьИсключение "Поддерживается только незащищённое соединение HTTP.";
	КонецЕсли;
	
	ПозицияПути = СтрНайти(Адрес, "/");
	Если ПозицияПути > 0 Тогда
		ПутьБазы = Сред(Адрес, ПозицияПути);
		Адрес = Лев(Адрес, ПозицияПути - 1);
	Иначе
		ПутьБазы = "";
	КонецЕсли;
	
	ПозицияПорта = СтрНайти(Адрес, ":");
	Если ПозицияПорта > 0 Тогда
		Хост = Лев(Адрес, ПозицияПорта - 1);
		Порт = Число(Сред(Адрес, ПозицияПорта + 1));
	Иначе
		Хост = Адрес;
		Порт = 80;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Хост", Хост);
	Результат.Вставить("Порт", Порт);
	Результат.Вставить("База", ПутьБазы);
	
	Возврат Результат;
	
КонецФункции

// Добавляет ссылку, построенную по уникальному идентификатору, в список.
//
// Параметры:
//  Список - Массив - список ссылок.
//  Менеджер - СправочникМенеджер, ДокументМенеджер - менеджер объекта.
//  Идентификатор - Строка - уникальный идентификатор объекта.
Процедура ДобавитьСсылкуПоИдентификатору(Список, Менеджер, Идентификатор)
	
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	Список.Добавить(Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор)));
	
КонецПроцедуры

// Возвращает соответствие существующих ссылок.
//
// Параметры:
//  ПолноеИмяТаблицы - Строка - полное имя таблицы, например "Документ.Доставка".
//  Список - Массив - проверяемые ссылки.
//
// Возвращаемое значение:
//  Соответствие - существующие ссылки:
//   * Ключ - ЛюбаяСсылка - ссылка;
//   * Значение - Булево - Истина.
Функция СуществующиеСсылки(ПолноеИмяТаблицы, Список)
	
	Результат = Новый Соответствие;
	Если Список.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	Таблица.Ссылка КАК Ссылка
		|ИЗ
		|	" + ПолноеИмяТаблицы + " КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка В (&Список)";
	Запрос.УстановитьПараметр("Список", Список);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение свойства структуры.
//
// Параметры:
//  Данные - Произвольный - структура с данными.
//  ИмяСвойства - Строка - имя свойства.
//
// Возвращаемое значение:
//  Произвольный - значение свойства или Неопределено.
Функция ЗначениеСвойства(Данные, ИмяСвойства)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Данные.Получить(ИмяСвойства);
	
КонецФункции

// Возвращает строковое значение свойства структуры.
//
// Параметры:
//  Данные - Произвольный - структура с данными.
//  ИмяСвойства - Строка - имя свойства.
//
// Возвращаемое значение:
//  Строка - значение свойства.
Функция СтроковоеЗначение(Данные, ИмяСвойства)
	
	Значение = ЗначениеСвойства(Данные, ИмяСвойства);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции

// Возвращает числовое значение свойства структуры.
//
// Параметры:
//  Данные - Произвольный - структура с данными.
//  ИмяСвойства - Строка - имя свойства.
//
// Возвращаемое значение:
//  Число - значение свойства.
Функция ЧисловоеЗначение(Данные, ИмяСвойства)
	
	Значение = ЗначениеСвойства(Данные, ИмяСвойства);
	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Число(Значение);
	
КонецФункции

// Преобразует строку даты в формате "ГГГГММДДЧЧММСС" в значение типа Дата.
//
// Параметры:
//  СтрокаДаты - Строка - дата в формате "ГГГГММДДЧЧММСС".
//
// Возвращаемое значение:
//  Дата - дата документа.
Функция ДатаИзСтроки(СтрокаДаты)
	
	Значение = СокрЛП(Строка(СтрокаДаты));
	Если СтрДлина(Значение) < 14 Тогда
		Возврат ТекущаяДата();
	КонецЕсли;
	
	Возврат Дата(
		Число(Лев(Значение, 4)),
		Число(Сред(Значение, 5, 2)),
		Число(Сред(Значение, 7, 2)),
		Число(Сред(Значение, 9, 2)),
		Число(Сред(Значение, 11, 2)),
		Число(Сред(Значение, 13, 2)));
	
КонецФункции

// Возвращает строковое имя статуса доставки.
//
// Параметры:
//  Статус - ПеречислениеСсылка.СтатусыДоставок - статус.
//
// Возвращаемое значение:
//  Строка - имя статуса.
Функция СтатусВСтроку(Статус)
	
	Если Статус = Перечисления.СтатусыДоставок.Запланирована Тогда
		Возврат "Запланирована";
	ИначеЕсли Статус = Перечисления.СтатусыДоставок.ВзятаВРаботу Тогда
		Возврат "ВзятаВРаботу";
	ИначеЕсли Статус = Перечисления.СтатусыДоставок.ОтклоненаКурьером Тогда
		Возврат "ОтклоненаКурьером";
	ИначеЕсли Статус = Перечисления.СтатусыДоставок.ОтклоненаКлиентом Тогда
		Возврат "ОтклоненаКлиентом";
	ИначеЕсли Статус = Перечисления.СтатусыДоставок.Выполнена Тогда
		Возврат "Выполнена";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Возвращает статус доставки по строковому имени.
//
// Параметры:
//  ИмяСтатуса - Строка - имя статуса.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СтатусыДоставок - статус.
Функция СтатусПоСтроке(ИмяСтатуса)
	
	Если ИмяСтатуса = "Запланирована" Тогда
		Возврат Перечисления.СтатусыДоставок.Запланирована;
	ИначеЕсли ИмяСтатуса = "ВзятаВРаботу" Тогда
		Возврат Перечисления.СтатусыДоставок.ВзятаВРаботу;
	ИначеЕсли ИмяСтатуса = "ОтклоненаКурьером" Тогда
		Возврат Перечисления.СтатусыДоставок.ОтклоненаКурьером;
	ИначеЕсли ИмяСтатуса = "ОтклоненаКлиентом" Тогда
		Возврат Перечисления.СтатусыДоставок.ОтклоненаКлиентом;
	ИначеЕсли ИмяСтатуса = "Выполнена" Тогда
		Возврат Перечисления.СтатусыДоставок.Выполнена;
	КонецЕсли;
	
	Возврат Перечисления.СтатусыДоставок.ПустаяСсылка();
	
КонецФункции

#КонецОбласти
