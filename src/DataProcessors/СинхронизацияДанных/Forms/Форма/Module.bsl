#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресСервера = Константы.АдресСервера.Получить();
	Логин = Константы.Логин.Получить();
	Пароль = Константы.Пароль.Получить();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Синхронизировать(Команда)
	
	Результат = "Выполняется синхронизация...";
	ВыполнитьСинхронизациюНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьСинхронизациюНаСервере()
	
	Константы.АдресСервера.Установить(СокрЛП(АдресСервера));
	Константы.Логин.Установить(СокрЛП(Логин));
	Константы.Пароль.Установить(Пароль);
	
	Попытка
		Результат = ОбменСЦентральнойБазой.ВыполнитьСинхронизацию();
	Исключение
		Результат = "Ошибка синхронизации: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
